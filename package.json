{
  "private": true,
  "name": "pearcircle",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:bare": "bare-pack --linked --defer fs --defer path src/bare.js -o assets/bare-universal.bundle",
    "build:bare:ios": "bare-pack --preset ios --defer fs --defer path src/bare.js -o assets/bare-ios.bundle",
    "build:ui": "esbuild src/ui/main.jsx --bundle --format=iife --jsx=automatic --loader:.js=jsx --loader:.css=text --loader:.png=dataurl --define:process.env.NODE_ENV=\\\"production\\\" --outfile=assets/app-ui.bundle",
    "test": "jest",
    "verify": "npm test && npm run build:bare && npm run build:bare:ios && npm run build:ui",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "autobase": "^7.25.1",
    "b4a": "^1.8.0",
    "corestore": "^7.8.0",
    "expo": "^54.0.10",
    "expo-build-properties": "^1.0.9",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "^18.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-linking": "^8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "^6.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-system-ui": "^6.0.7",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.26.0",
    "hyperdht": "^6.29.0",
    "hyperswarm": "^4.17.0",
    "maplibre-gl": "^5.24.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-b4a": "^0.0.4",
    "react-native-bare-kit": "^0.12.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.3",
    "babel-jest": "^29.7.0",
    "bare": "^1.28.5",
    "bare-bundle": "^1.10.0",
    "bare-pack": "^2.0.0",
    "esbuild": "^0.27.3",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "^4.1.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.3.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/**/*.test.js"
        ]
      },
      {
        "displayName": "jsdom",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/src/ui/**/*.test.js",
          "<rootDir>/src/ui/**/*.test.jsx"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.js"
        ],
        "transform": {
          "^.+\\.jsx?$": "babel-jest"
        }
      }
    ]
  }
}
