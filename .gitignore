# Release pipeline. scripts/app.conf is tracked since it's app-config rather
# than credentials.
scripts/ios-appstore.sh
scripts/frame-android-screenshots.sh
scripts/assets/
scripts/.env
.env
# Seeder build/release tooling is tracked in git. It was previously untracked
# as "machine-specific", but a working-tree loss then silently dropped the
# scripts from a release (only Windows survived), so a fresh clone could no
# longer build the seeder installers. The scripts default to personal build
# hosts via overridable env vars (e.g. WINDOWS_VM_HOST, MAC_MINI_HOST) and
# bake in no secrets, so tracking them is safe. scripts/release.sh is tracked
# for the same reason (it sources all credentials from scripts/.env, which
# stays untracked).

# Store-listing assets and the Zapstore publish manifest live locally.
# Screenshots, framed bezel composites, store-listing copy, icon and
# feature-graphic exports are all bulky binary or PR-style content that
# the release scripts regenerate; no need to bloat the public repo.
metadata/
store/
zapstore.yaml

